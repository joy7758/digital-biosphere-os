{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redcrag.cn/schemas/dba-intelligence-agent-index-v0.1.json",
  "title": "DBA External Intelligence Agent Index v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "canonical_agent_entry",
    "primary_repository",
    "current_bundle",
    "artifacts",
    "authority_boundaries"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "format_version": { "const": "0.1.0" },
    "canonical_agent_entry": { "const": true },
    "primary_repository": { "const": "DBA" },
    "purpose": { "type": "string", "minLength": 1 },
    "current_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "status", "brief"],
      "properties": {
        "observed_at": { "type": "string", "format": "date" },
        "status": { "type": "string", "minLength": 1 },
        "brief": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "path", "status"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authority_boundaries": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
