{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/private-stage5/schemas/specification-proposal.schema.json",
  "title": "TITMAS Stage 5 Specification Proposal v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proposal_id",
    "title",
    "problem",
    "developer_value",
    "scope",
    "non_goals",
    "affected_objects",
    "proposed_change",
    "compatibility",
    "positive_cases",
    "negative_cases",
    "failure_behavior",
    "source_refs",
    "ai_assistance_disclosure",
    "human_decisions_required"
  ],
  "properties": {
    "proposal_id": {"type": "string", "pattern": "^STAGE5-PROP-[A-Z0-9-]{3,48}$"},
    "title": {"type": "string", "minLength": 5, "maxLength": 160},
    "problem": {"type": "string", "minLength": 20, "maxLength": 1600},
    "developer_value": {"type": "string", "minLength": 20, "maxLength": 1200},
    "scope": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 240}
    },
    "non_goals": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 240}
    },
    "affected_objects": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
    },
    "proposed_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "field_changes"],
      "properties": {
        "summary": {"type": "string", "minLength": 20, "maxLength": 1600},
        "field_changes": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"type": "string", "minLength": 3, "maxLength": 320}
        }
      }
    },
    "compatibility": {
      "enum": ["BACKWARD_COMPATIBLE", "BREAKING_CHANGE", "NOT_ASSESSED"]
    },
    "positive_cases": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"type": "string", "minLength": 5, "maxLength": 400}
    },
    "negative_cases": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"type": "string", "minLength": 5, "maxLength": 400}
    },
    "failure_behavior": {"type": "string", "minLength": 10, "maxLength": 800},
    "source_refs": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"}
    },
    "ai_assistance_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assisted", "provider", "model", "scope", "human_accountability"],
      "properties": {
        "assisted": {"type": "boolean"},
        "provider": {"type": "string", "minLength": 2, "maxLength": 80},
        "model": {"type": "string", "minLength": 2, "maxLength": 120},
        "scope": {"type": "string", "minLength": 2, "maxLength": 400},
        "human_accountability": {"const": "REQUIRED"}
      }
    },
    "human_decisions_required": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 240}
    }
  }
}
