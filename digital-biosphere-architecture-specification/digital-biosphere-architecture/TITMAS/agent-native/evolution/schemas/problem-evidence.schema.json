{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/d19/problem-evidence-2.1.json",
  "title": "TITMAS ProblemEvidenceObject v2.1",
  "type": "object",
  "required": [
    "problem_id",
    "discovered_by_agent",
    "discovered_at",
    "affected_component",
    "canonical_owner_repository",
    "observation",
    "reproduction",
    "evidence_references",
    "severity",
    "risk_class",
    "agent_impact",
    "security_impact",
    "authority_impact",
    "confidence",
    "known_limitations"
  ],
  "properties": {
    "problem_id": {"type": "string", "pattern": "[A-Z0-9][A-Z0-9._-]{4,127}"},
    "discovered_by_agent": {"type": "string", "minLength": 3},
    "discovered_at": {"type": "string", "minLength": 20},
    "affected_component": {"type": "string", "minLength": 3},
    "canonical_owner_repository": {"type": "string", "minLength": 3},
    "observation": {
      "type": "object",
      "required": ["type", "summary", "source_reference"],
      "properties": {
        "type": {"type": "string"},
        "summary": {"type": "string", "minLength": 8},
        "source_reference": {"type": "string", "minLength": 3}
      },
      "additionalProperties": false
    },
    "reproduction": {
      "type": "object",
      "required": ["status", "attempts", "steps", "expected", "observed"],
      "properties": {
        "status": {"enum": ["REPRODUCED", "NOT_REPRODUCED", "NOT_ASSESSED"]},
        "attempts": {"type": "integer"},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "expected": {"type": "string"},
        "observed": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "severity": {"enum": ["INFO", "LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "risk_class": {"enum": ["ER-0", "ER-1", "ER-2", "ER-3", "ER-4"]},
    "agent_impact": {"type": "string"},
    "security_impact": {"type": "string"},
    "authority_impact": {"type": "string"},
    "confidence": {"type": "number"},
    "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
