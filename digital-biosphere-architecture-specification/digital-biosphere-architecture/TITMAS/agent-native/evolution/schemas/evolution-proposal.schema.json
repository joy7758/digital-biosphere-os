{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/d19/evolution-proposal-2.1.json",
  "title": "TITMAS EvolutionProposalObject v2.1",
  "type": "object",
  "required": [
    "evolution_id",
    "problem_id",
    "objective",
    "proposed_variants",
    "fitness_dimensions",
    "forbidden_changes",
    "required_tests",
    "required_reviewers",
    "authorization_class",
    "rollback_requirements"
  ],
  "properties": {
    "evolution_id": {"type": "string", "pattern": "[A-Z0-9][A-Z0-9._-]{4,127}"},
    "problem_id": {"type": "string"},
    "objective": {"type": "string", "minLength": 8},
    "proposed_variants": {"type": "array", "minItems": 2, "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "fitness_dimensions": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "forbidden_changes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "required_tests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "required_reviewers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "authorization_class": {"enum": ["ER-0", "ER-1", "ER-2", "ER-3", "ER-4"]},
    "rollback_requirements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
