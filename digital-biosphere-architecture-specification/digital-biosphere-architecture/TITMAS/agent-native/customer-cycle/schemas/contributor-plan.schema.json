{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/contributor-plan.schema.json",
  "title": "TITMAS Contributor Plan Result v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "problem_understood",
    "contract_version",
    "relevance_preassessment",
    "selected_operation",
    "request_body",
    "expected_public_result_shape",
    "decision_criteria",
    "limitations",
    "non_claims"
  ],
  "properties": {
    "problem_understood": {"type": "string", "minLength": 1, "maxLength": 1024},
    "contract_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "relevance_preassessment": {
      "enum": ["RELEVANT", "CONDITIONALLY_RELEVANT", "NOT_RELEVANT"]
    },
    "selected_operation": {"enum": ["EVALUATE", "VERIFY", "ABSTAIN"]},
    "request_body": {"type": "object"},
    "expected_public_result_shape": {"type": "object"},
    "decision_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "maxLength": 512}
    },
    "non_claims": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "maxLength": 512}
    }
  }
}
