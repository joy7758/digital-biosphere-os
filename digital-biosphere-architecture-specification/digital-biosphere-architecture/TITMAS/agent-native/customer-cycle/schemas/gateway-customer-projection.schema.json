{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/gateway-customer-projection.schema.json",
  "title": "TITMAS Gateway Customer Projection v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "http_status",
    "public_reason_code",
    "request_body_sha256",
    "response_body_sha256",
    "customer_visible_result",
    "limitations"
  ],
  "properties": {
    "operation": {"enum": ["EVALUATE", "VERIFY"]},
    "http_status": {"type": "integer"},
    "public_reason_code": {"type": "string", "minLength": 1, "maxLength": 256},
    "request_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "response_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "customer_visible_result": {"type": "object"},
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "maxLength": 512}
    }
  }
}
