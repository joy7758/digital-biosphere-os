{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/schemas/semantic-checkpoint-envelope.schema.json",
  "title": "TITMAS Sanitized Semantic Checkpoint Envelope v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "cycle_id",
    "stage",
    "checkpoint_state",
    "source_main",
    "gateway_revision",
    "attempt_id",
    "provider",
    "requested_model",
    "returned_model",
    "model_identity_status",
    "response_envelope_ref",
    "response_body_sha256",
    "structured_content_sha256",
    "checkpoint_payload_sha256",
    "contract_schema",
    "contract_validation_status",
    "sanitization_status",
    "created_at",
    "persisted_at",
    "finalized_at",
    "downstream_dispatch_authorized",
    "raw_prompt_retained",
    "raw_response_retained",
    "hidden_reasoning_retained",
    "credential_material_retained",
    "structured_result",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "checkpoint_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "cycle_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "stage": {
      "enum": [
        "CONTRIBUTOR_PLAN",
        "GATEWAY_CUSTOMER_PROJECTION",
        "CONTRIBUTOR_ASSESSMENT",
        "INDEPENDENT_REVIEW",
        "STANDARD_CONTRIBUTION",
        "STANDARD_REVIEW"
      ]
    },
    "checkpoint_state": {"enum": ["PERSISTING", "DURABLE"]},
    "source_main": {"type": "string", "minLength": 7, "maxLength": 64},
    "gateway_revision": {"type": "string", "minLength": 7, "maxLength": 64},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider": {"type": "string", "minLength": 1, "maxLength": 128},
    "requested_model": {"type": "string", "minLength": 1, "maxLength": 128},
    "returned_model": {"type": "string", "minLength": 1, "maxLength": 128},
    "model_identity_status": {"const": "MATCH"},
    "response_envelope_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "response_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "structured_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpoint_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contract_schema": {"type": "string", "minLength": 1, "maxLength": 128},
    "contract_validation_status": {"const": "PASS"},
    "sanitization_status": {"const": "PASS"},
    "created_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "persisted_at": {"type": "string", "maxLength": 64},
    "finalized_at": {"type": "string", "maxLength": 64},
    "downstream_dispatch_authorized": {"type": "boolean"},
    "raw_prompt_retained": {"const": false},
    "raw_response_retained": {"const": false},
    "hidden_reasoning_retained": {"const": false},
    "credential_material_retained": {"const": false},
    "structured_result": {"type": "object"},
    "limitations": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "maxLength": 512}
    }
  }
}
