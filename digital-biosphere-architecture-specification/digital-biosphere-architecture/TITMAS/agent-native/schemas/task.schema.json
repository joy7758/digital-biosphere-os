{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id", "title", "intent", "value_hypothesis", "problem_context",
    "relevance_conditions", "non_applicable_conditions", "required_capabilities",
    "allowed_participant_roles", "risk_class", "allowed_files", "forbidden_files",
    "dependencies", "source_revision", "expected_outputs", "required_tests",
    "negative_tests", "completion_conditions", "stop_conditions", "authority_reference",
    "lease_duration_seconds", "expiry", "conflict_policy", "duplication_policy",
    "estimated_context_requirement", "human_escalation_conditions", "status"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "title": {"type": "string"},
    "intent": {"type": "string"},
    "value_hypothesis": {"type": "string"},
    "problem_context": {"type": "string"},
    "relevance_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "non_applicable_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_participant_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "evolution_risk_class": {"enum": ["ER-0", "ER-1", "ER-2", "ER-3", "ER-4"]},
    "canonical_owner": {"type": "string"},
    "auto_repair_eligibility": {"enum": ["NOT_ELIGIBLE", "DRAFT_PR_ONLY", "STANDING_POLICY_REQUIRED"]},
    "human_authorization_required": {"type": "boolean"},
    "rollback_required": {"type": "boolean"},
    "fitness_dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "forbidden_files": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "source_revision": {"type": "string"},
    "expected_outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "negative_tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "completion_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "authority_reference": {"type": "string"},
    "lease_duration_seconds": {"type": "integer"},
    "expiry": {"type": "string", "format": "date-time"},
    "conflict_policy": {"type": "string"},
    "duplication_policy": {"type": "string"},
    "estimated_context_requirement": {"type": "integer"},
    "human_escalation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "status": {"enum": ["AVAILABLE", "CLAIM_REQUESTED", "CLAIMED", "IN_PROGRESS", "REVIEW_REQUESTED", "REVISION_REQUIRED", "ACCEPTED_AS_CANDIDATE", "REJECTED", "ABANDONED", "EXPIRED", "SUPERSEDED"]}
  },
  "additionalProperties": false
}
