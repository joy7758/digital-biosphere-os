  "properties": {
    "expiry_id": {"type": "string"},
    "subject_ref": {"type": "string"},
    "expires_at": {"type": "string"},
    "evaluated_at": {"type": "string"},
    "result": {"enum": ["ACTIVE", "EXPIRED", "NOT_ASSESSED"]}
  },
  "additionalProperties": false
}
