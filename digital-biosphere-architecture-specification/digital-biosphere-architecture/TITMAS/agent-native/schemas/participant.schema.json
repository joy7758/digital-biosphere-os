{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "participant_ref",
    "participant_identity_ref",
    "provider_ref",
    "model_identity",
    "runtime_identity",
    "session_identity",
    "owner_or_operator_ref",
    "authority_issuer_ref",
    "lineage_ref",
    "declared_capabilities",
    "declared_limitations",
    "assigned_roles",
    "allowed_scope",
    "prohibited_scope",
    "valid_from",
    "expires_at",
    "revocation_ref",
    "evidence_refs"
  ],
  "properties": {
    "participant_ref": {"type": "string"},
    "participant_identity_ref": {"type": "string"},
    "provider_ref": {"type": "string"},
    "model_identity": {"type": "string"},
    "runtime_identity": {"type": "string"},
    "session_identity": {"type": "string"},
    "owner_or_operator_ref": {"type": "string"},
    "authority_issuer_ref": {"type": "string"},
    "lineage_ref": {"type": "string"},
    "declared_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "declared_limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "assigned_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "allowed_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prohibited_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "valid_from": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "revocation_ref": {"type": "string"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
