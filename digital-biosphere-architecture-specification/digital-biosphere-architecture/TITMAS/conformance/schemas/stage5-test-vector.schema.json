{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/private-stage5/schemas/test-vector.schema.json",
  "title": "TITMAS Stage 5 Test Vector v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vector_id",
    "target_specification",
    "input",
    "expected_result",
    "expected_reason_code",
    "positive_or_negative",
    "failure_classification",
    "source_refs",
    "limitations"
  ],
  "properties": {
    "vector_id": {"type": "string", "pattern": "^STAGE5-VECTOR-[A-Z0-9-]{3,48}$"},
    "target_specification": {"type": "string", "minLength": 3, "maxLength": 160},
    "input": {"type": "object"},
    "expected_result": {"type": "object"},
    "expected_reason_code": {"type": "string", "pattern": "^TITMAS-[A-Z0-9-]{3,96}$"},
    "positive_or_negative": {"enum": ["POSITIVE", "NEGATIVE"]},
    "failure_classification": {
      "enum": ["NONE", "SCHEMA", "SEMANTIC", "AUTHORITY", "BOUNDARY", "NOT_ASSESSED"]
    },
    "source_refs": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,255}$"}
    },
    "limitations": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"type": "string", "minLength": 3, "maxLength": 400}
    }
  }
}
