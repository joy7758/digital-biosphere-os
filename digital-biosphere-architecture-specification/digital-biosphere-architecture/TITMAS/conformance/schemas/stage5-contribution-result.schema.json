{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/private-stage5/schemas/contribution-result.schema.json",
  "title": "TITMAS Stage 5 Contribution Result v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "submission_id",
    "contribution_type",
    "status",
    "conformance_status",
    "review_status",
    "human_disposition_required",
    "reason_codes",
    "hashes",
    "limitations"
  ],
  "properties": {
    "submission_id": {"type": "string", "pattern": "^stage5-submission-[A-Za-z0-9-]{4,64}$"},
    "contribution_type": {
      "enum": ["SPECIFICATION_PROPOSAL", "ADAPTER_MAPPING", "TEST_VECTOR"]
    },
    "status": {
      "enum": [
        "RECEIVED",
        "VALIDATING",
        "CONFORMANCE_PASS",
        "CONFORMANCE_FAIL",
        "REVIEW_REQUIRED",
        "HUMAN_DISPOSITION_REQUIRED",
        "PILOT_ACCEPTED",
        "PILOT_REJECTED"
      ]
    },
    "conformance_status": {
      "enum": ["NOT_RUN", "CONFORMANCE_PASS", "CONFORMANCE_FAIL"]
    },
    "review_status": {
      "enum": ["NOT_RUN", "PASS", "REVISION_REQUIRED", "REJECT"]
    },
    "human_disposition_required": {"type": "boolean"},
    "reason_codes": {
      "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^TITMAS-[A-Z0-9-]{3,96}$"}
    },
    "hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["submission_sha256", "result_sha256"],
      "properties": {
        "submission_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "limitations": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"type": "string", "minLength": 3, "maxLength": 400}
    }
  }
}
