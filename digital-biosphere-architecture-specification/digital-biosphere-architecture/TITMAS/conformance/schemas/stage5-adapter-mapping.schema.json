{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titmas.cn/private-stage5/schemas/adapter-mapping.schema.json",
  "title": "TITMAS Stage 5 Adapter Mapping v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adapter_id",
    "source_system",
    "source_version",
    "source_license",
    "source_semantics",
    "titmas_bindings",
    "unsupported_fields",
    "conflicts",
    "positive_cases",
    "negative_cases",
    "limitations",
    "ai_assistance_disclosure"
  ],
  "properties": {
    "adapter_id": {"type": "string", "pattern": "^STAGE5-ADAPTER-[A-Z0-9-]{3,48}$"},
    "source_system": {"type": "string", "minLength": 2, "maxLength": 120},
    "source_version": {"type": "string", "minLength": 1, "maxLength": 80},
    "source_license": {"type": "string", "minLength": 2, "maxLength": 120},
    "source_semantics": {
      "type": "array", "minItems": 1, "maxItems": 24,
      "items": {"type": "string", "minLength": 3, "maxLength": 320}
    },
    "titmas_bindings": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_field", "titmas_object", "titmas_field", "mapping_rule"],
        "properties": {
          "source_field": {"type": "string", "minLength": 1, "maxLength": 160},
          "titmas_object": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
          "titmas_field": {"type": "string", "minLength": 1, "maxLength": 160},
          "mapping_rule": {"type": "string", "minLength": 3, "maxLength": 480}
        }
      }
    },
    "unsupported_fields": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 160}
    },
    "conflicts": {
      "type": "array", "maxItems": 16,
      "items": {"type": "string", "minLength": 3, "maxLength": 400}
    },
    "positive_cases": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"type": "string", "minLength": 5, "maxLength": 400}
    },
    "negative_cases": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"type": "string", "minLength": 5, "maxLength": 400}
    },
    "limitations": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"type": "string", "minLength": 3, "maxLength": 400}
    },
    "ai_assistance_disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assisted", "provider", "model", "scope", "human_accountability"],
      "properties": {
        "assisted": {"type": "boolean"},
        "provider": {"type": "string", "minLength": 2, "maxLength": 80},
        "model": {"type": "string", "minLength": 2, "maxLength": 120},
        "scope": {"type": "string", "minLength": 2, "maxLength": 400},
        "human_accountability": {"const": "REQUIRED"}
      }
    }
  }
}
