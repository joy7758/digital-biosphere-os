{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redcrag.cn/schemas/constitution-machine-contract-v0.1.schema.json",
  "title": "DBA and TITMAS constitutional machine contract v0.1",
  "type": "object",
  "required": [
    "$schema",
    "contract_id",
    "contract_type",
    "version",
    "status",
    "title",
    "title_zh",
    "parent_constitution_ref",
    "authority_effect",
    "human_adoption_decision",
    "effective_trigger",
    "canonical_ref",
    "authorized_content_head",
    "candidate_branch_authority_effect",
    "post_merge_authority_effect",
    "merge_authorized",
    "implementation_authorized",
    "principles",
    "invariants",
    "non_claims",
    "source_refs",
    "limitations"
  ],
  "properties": {
    "$schema": {
      "const": "schemas/constitution-machine-contract-v0.1.schema.json"
    },
    "contract_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
    },
    "contract_type": {
      "enum": [
        "DBA_MAIN_CONSTITUTION_PRINCIPLES",
        "TITMAS_PROJECT_CONSTITUTION",
        "DCELL_MODULE_GOVERNANCE_PROFILE"
      ]
    },
    "version": {
      "const": "0.1.0"
    },
    "status": {
      "const": "ACCEPTED_EFFECTIVE_ON_CANONICAL_MERGE"
    },
    "title": {
      "type": "string",
      "minLength": 10
    },
    "title_zh": {
      "type": "string",
      "minLength": 4
    },
    "parent_constitution_ref": {
      "type": "string",
      "minLength": 4
    },
    "authority_effect": {
      "const": "EFFECTIVE_WHEN_REACHABLE_FROM_CANONICAL_MAIN"
    },
    "human_adoption_decision": {
      "const": "APPROVED"
    },
    "effective_trigger": {
      "const": "REACHABLE_FROM_CANONICAL_MAIN"
    },
    "canonical_ref": {
      "const": "refs/heads/main"
    },
    "authorized_content_head": {
      "const": "440d0163aea1577437a2a9c6737a37e0af47663a"
    },
    "candidate_branch_authority_effect": {
      "const": "NONE"
    },
    "post_merge_authority_effect": {
      "const": "ADOPTED_AND_EFFECTIVE"
    },
    "merge_authorized": {
      "const": true
    },
    "implementation_authorized": {
      "const": false
    },
    "human_interface_contract": {
      "type": "object",
      "required": [
        "human_readback_must_be_comprehensible",
        "human_readback_must_use_declared_principal_or_market_locale",
        "locale_must_be_explicitly_declared",
        "critical_status_must_not_be_machine_code_only",
        "machine_contract_and_localized_explanation_must_coexist",
        "global_hardcoded_human_locale"
      ],
      "properties": {
        "human_readback_must_be_comprehensible": {"const": true},
        "human_readback_must_use_declared_principal_or_market_locale": {"const": true},
        "locale_must_be_explicitly_declared": {"const": true},
        "critical_status_must_not_be_machine_code_only": {"const": true},
        "machine_contract_and_localized_explanation_must_coexist": {"const": true},
        "global_hardcoded_human_locale": {"const": false},
        "machine_contract_remains_canonical": {"type": "boolean"},
        "localized_explanation_creates_authority": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "permission_model": {
      "type": "object",
      "required": [
        "formula",
        "applicable_constraints",
        "applicable_constraint_intersection_required",
        "human_approval_always_required",
        "human_approval_required_when_policy_requires",
        "human_approval_required_when_risk_class_requires",
        "human_approval_required_when_action_class_requires",
        "human_approval_required_on_explicit_escalation",
        "not_applicable_constraint_is_missing_constraint",
        "unknown_applicability_fails_closed",
        "approval_binding_required",
        "decision_outcomes",
        "conformance_examples"
      ],
      "properties": {
        "formula": {"type": "string", "minLength": 20},
        "applicable_constraints": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "applicable_constraint_intersection_required": {"const": true},
        "human_approval_always_required": {"const": false},
        "human_approval_required_when_policy_requires": {"const": true},
        "human_approval_required_when_risk_class_requires": {"const": true},
        "human_approval_required_when_action_class_requires": {"const": true},
        "human_approval_required_on_explicit_escalation": {"const": true},
        "not_applicable_constraint_is_missing_constraint": {"const": false},
        "unknown_applicability_fails_closed": {"const": true},
        "approval_binding_required": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string"}},
        "decision_outcomes": {
          "type": "object",
          "required": ["ALLOW_OR_READY", "NEEDS_APPROVAL", "BLOCK", "NOT_ASSESSED_AND_FAIL_CLOSED"],
          "properties": {
            "ALLOW_OR_READY": {"type": "string", "minLength": 20},
            "NEEDS_APPROVAL": {"type": "string", "minLength": 20},
            "BLOCK": {"type": "string", "minLength": 20},
            "NOT_ASSESSED_AND_FAIL_CLOSED": {"type": "string", "minLength": 20}
          },
          "additionalProperties": false
        },
        "conformance_examples": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "required": ["case_id", "approval_applicable", "non_overridable_deny", "applicability_known", "expected_outcome"]
          }
        }
      }
    },
    "principles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "stable_id",
          "title",
          "title_zh",
          "status",
          "statement",
          "statement_zh",
          "source_refs"
        ],
        "properties": {
          "stable_id": {
            "type": "string",
            "pattern": "^[A-Z0-9][A-Z0-9._-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 4
          },
          "title_zh": {
            "type": "string",
            "minLength": 2
          },
          "status": {
            "enum": [
              "REUSED_ACCEPTED_PRINCIPLE",
              "ADOPTED_CONSTITUTIONAL_EXTENSION"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 20
          },
          "statement_zh": {
            "type": "string",
            "minLength": 8
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 4
            }
          }
        },
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+=(true|false)$"
      }
    },
    "non_claims": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 4
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 4
      }
    }
  }
}
