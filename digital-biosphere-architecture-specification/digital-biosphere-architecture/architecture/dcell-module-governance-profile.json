  "principles": [
    {
      "stable_id": "DCELL-P-CELL-GRADE-GOVERNANCE",
      "title": "Skill-like selection with cell-grade governance",
      "title_zh": "技能式选择与细胞级治理",
      "status": "ADOPTED_CONSTITUTIONAL_EXTENSION",
      "statement": "A DCell may be selected like a skill, but admission, permission, composition, evidence, lifecycle and revalidation remain governed as a digital entity module.",
      "statement_zh": "DCell可以像技能一样被选择，但准入、权限、组合、证据、生命周期和重新核验必须按数字主体模块治理。",
      "source_refs": [
        "architecture/digital-entity-specification.md",
        "architecture/capability-boundary-specification.md"
      ]
    },
    {
      "stable_id": "DCELL-P-PERMISSION-INTERSECTION",
      "title": "Permission intersection",
      "title_zh": "权限交集",
      "status": "ADOPTED_CONSTITUTIONAL_EXTENSION",
      "statement": "Effective module permission is the intersection of entity permission, task authorization, module constraints, policy constraints and current context validity.",
      "statement_zh": "模块有效权限是主体权限、任务授权、模块约束、策略约束和当前上下文有效性的交集。",
      "source_refs": [
        "architecture/capability-boundary-specification.md",
        "architecture/governance-decision-model.md"
      ]
    },
    {
      "stable_id": "DCELL-P-CHANGE-REVALIDATION",
      "title": "Composition and version change revalidation",
      "title_zh": "组合与版本变化重新核验",
      "status": "ADOPTED_CONSTITUTIONAL_EXTENSION",
      "statement": "Selecting, removing, updating or recomposing a module invalidates inherited conclusions until the affected composition is revalidated.",
      "statement_zh": "选择、移除、更新或重组模块都会使继承结论失效，直到受影响组合完成重新核验。",
      "source_refs": [
        "architecture/ADR-039-verified-correction-and-execution-context-continuity.md"
      ]
    },
    {
      "stable_id": "DCELL-P-USABILITY-AS-SAFETY",
      "title": "Usability is a constitutional safety property",
      "title_zh": "可用性是宪法级安全属性",
      "status": "ADOPTED_CONSTITUTIONAL_EXTENSION",
      "statement": "A first-value path that requires hidden command syntax, schema guessing or manual secret handling is not constitutionally usable for the intended agent or human entry.",
      "statement_zh": "首次价值路径若要求隐藏命令语法、猜测Schema或手工处理秘密，就不满足预期智能体或人类入口的宪法级可用性。",
      "source_refs": [
        "commercial/entry/first-value-contract.schema.json",
        "commercial/entry/customer-entry-check.json"
      ]
    }
  ],
