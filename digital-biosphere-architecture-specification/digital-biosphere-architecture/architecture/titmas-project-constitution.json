  "principles": [
    {
      "stable_id": "TITMAS-P-INHERIT-DBA",
      "title": "DBA constitutional inheritance",
      "title_zh": "继承DBA主宪法",
      "status": "ADOPTED_CONSTITUTIONAL_EXTENSION",
      "statement": "TITMAS inherits the DBA main constitution and may narrow its own scope but may not override parent authority, truth, ownership or evidence boundaries.",
      "statement_zh": "TITMAS继承DBA主宪法，可以收窄自身范围，但不得覆盖父级权威、事实、所有权或证据边界。",
      "source_refs": [
        "architecture/main-constitution-principles.json"
      ]
    },
    {
      "stable_id": "TITMAS-P-UNIFIED-LOGICAL-ENTRY",
      "title": "Unified logical entry without physical centralization",
      "title_zh": "统一逻辑入口但不物理集中",
      "status": "ADOPTED_CONSTITUTIONAL_EXTENSION",
      "statement": "TITMAS may define a coherent machine-discovery and policy entry contract, but no global mandatory gateway or physical single control point is implied.",
      "statement_zh": "TITMAS可以定义一致的机器发现与策略入口契约，但不推导全局强制网关或物理单一控制点。",
      "source_refs": [
        "agent-index.json",
        "architecture/commercial-private-infrastructure-strategy-constitution.md"
      ]
    },
    {
      "stable_id": "TITMAS-P-DISTRIBUTED-ENFORCEMENT",
      "title": "Distributed and bounded enforcement",
      "title_zh": "分布式有界执法",
      "status": "ADOPTED_CONSTITUTIONAL_EXTENSION",
      "statement": "Policy decisions, evidence checks and revalidation may be enforced at owned integration points without turning TITMAS into a runtime, model, truth source or final authority.",
      "statement_zh": "策略决策、证据检查和重新核验可以在各自所有的接入点执行，但不得把TITMAS变成运行时、模型、事实源或最终权威。",
      "source_refs": [
        "architecture/saee-dbos-contract.md",
        "architecture/interface-boundary-rules.md"
      ]
    },
    {
      "stable_id": "TITMAS-P-REVALIDATE-COMPOSITION",
      "title": "Composition and change revalidation",
      "title_zh": "组合与变化重新核验",
      "status": "ADOPTED_CONSTITUTIONAL_EXTENSION",
      "statement": "A changed module, dependency, policy, permission or entity composition must not inherit an earlier PASS without context-bound revalidation.",
      "statement_zh": "模块、依赖、策略、权限或主体组合变化后，未经上下文绑定的重新核验不得继承早先的PASS。",
      "source_refs": [
        "architecture/ADR-039-verified-correction-and-execution-context-continuity.md"
      ]
    }
  ],
