{
  "cell_id": "PROJECT_DISCOVERY_CELL",
  "version": "0.1",
  "name": "PROJECT_DISCOVERY_CELL",
  "niche": "bounded weekly cockpit observation",
  "module": "cells.project_discovery",
  "class": "Project_Discovery_CellCell",
  "inputs": [
    "project-check-registry",
    "source-registry"
  ],
  "outputs": [
    "project-candidates"
  ],
  "source_dependencies": [
    "cockpit/source-registry.json"
  ],
  "evidence_requirements": [
    "manual-registration-or-existing-registry"
  ],
  "freshness_policy": "SOURCE_DEFINED_FAIL_CLOSED",
  "authority_boundaries": {
    "can_write_source_project": false,
    "can_create_pull_request": false,
    "can_merge": false,
    "can_deploy": false,
    "can_authorize": false,
    "can_change_project_priority": false
  },
  "failure_policy": {
    "status": "NOT_ASSESSED",
    "preserve_other_cells": true
  },
  "replacement": {
    "replaceable": true,
    "interface_version": "0.1"
  }
}
