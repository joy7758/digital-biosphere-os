{
  "cell_id": "MEMORY_CELL",
  "version": "0.1",
  "name": "MEMORY_CELL",
  "niche": "bounded weekly cockpit observation",
  "module": "cells.memory",
  "class": "Memory_CellCell",
  "inputs": [
    "current-snapshot",
    "previous-live-artifact"
  ],
  "outputs": [
    "lifecycle-delta"
  ],
  "source_dependencies": [
    "github-actions-read-only-artifact-memory",
    "cockpit/weekly/history"
  ],
  "evidence_requirements": [
    "stable-finding-identity",
    "successful-main-artifact"
  ],
  "freshness_policy": "NOT_ASSESSED_WITHOUT_PREVIOUS",
  "authority_boundaries": {
    "can_write_source_project": false,
    "can_create_pull_request": false,
    "can_merge": false,
    "can_deploy": false,
    "can_authorize": false,
    "can_change_project_priority": false
  },
  "failure_policy": {
    "status": "NOT_ASSESSED",
    "preserve_other_cells": true
  },
  "replacement": {
    "replaceable": true,
    "interface_version": "0.1"
  }
}
