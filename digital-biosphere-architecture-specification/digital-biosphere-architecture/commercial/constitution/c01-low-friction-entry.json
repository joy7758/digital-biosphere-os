{
  "contract_format": "TITMAS-COMMERCIAL-PRINCIPLE-1.0",
  "principle_id": "TITMAS-COMMERCIAL-C01",
  "name": "LOW_FRICTION_ENTRY_AND_PROGRESSIVE_VALUE",
  "name_zh": "低门槛进入与渐进式价值原则",
  "normative_status": "FROZEN_COMMERCIAL_CONSTITUTION",
  "display_order": 1,
  "decision_reference": "TITMAS-COMMERCIAL-CONSTITUTION-C01-LOW-FRICTION-ENTRY-D29-INTEGRATION",
  "principle": "TITMAS must provide verifiable initial value before requiring customers to understand the full architecture, surrender production control, disclose unnecessary sensitive data, deploy complex infrastructure, or commit to a high-cost commercial arrangement.",
  "principle_zh": "TITMAS必须在要求客户理解完整架构、交出生产控制权、披露不必要的敏感数据、部署复杂基础设施或承担高成本商业承诺之前，先提供一个真实、可解释、可验证的初始价值结果。",
  "one_line_freeze_zh": "先让客户看见价值，再要求客户承担集成和控制成本。",
  "requirements": {
    "first_value_before_enforcement": true,
    "monitor_before_enforce": true,
    "minimum_necessary_data": true,
    "reversible_entry": true,
    "clear_upgrade_path": true,
    "explanation_before_configuration": true,
    "proof_before_purchase_expansion": true,
    "first_value_without_core_source_access": true,
    "first_value_without_production_write_permission": true,
    "first_value_without_automatic_enforcement": true
  },
  "safety_invariants": {
