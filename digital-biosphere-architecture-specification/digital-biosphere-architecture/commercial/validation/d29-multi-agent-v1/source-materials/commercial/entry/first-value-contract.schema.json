{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://redcrag.cn/schemas/titmas/first-value-contract-v1.schema.json",
  "title": "TITMAS FirstValueContract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id", "entry_surface", "customer_type", "input_type",
    "required_architecture_concepts", "required_permissions", "required_data_classes",
    "production_write_access_required", "core_source_access_required",
    "automatic_enforcement_required", "enforce_activation_required", "raw_trace_required",
    "estimated_steps", "design_target_time_to_first_value", "design_target_not_achievement",
    "result_type", "result_explanation", "machine_reason_codes", "verification_available",
    "verification_contract_defined", "verification_runtime_available", "limitations",
    "reversible", "deletion_supported", "deletion_request_path_defined",
    "deletion_runtime_available", "next_stage", "non_claims"
  ],
  "properties": {
    "contract_id": {"type":"string", "pattern":"^TITMAS-FVC-[A-Z0-9_-]+$"},
    "entry_surface": {"enum":["SYNTHETIC_DEMO","PUBLIC_OR_REDACTED_TRACE_IMPORT","READ_ONLY_MONITOR"]},
    "customer_type": {"enum":["AI_AGENT","HUMAN","ORGANIZATION"]},
    "input_type": {"type":"string", "minLength":1},
    "required_architecture_concepts": {"type":"array", "maxItems":0},
    "required_permissions": {"type":"array", "items":{"enum":["READ_ONLY_IMPORT","READ_ONLY_OR_EVENT_COPY"]}},
    "required_data_classes": {"type":"array", "minItems":1, "items":{"type":"string", "minLength":1}},
    "production_write_access_required": {"const":false},
    "core_source_access_required": {"const":false},
    "automatic_enforcement_required": {"const":false},
    "enforce_activation_required": {"const":false},
    "raw_trace_required": {"const":false},
    "estimated_steps": {"type":"integer", "minimum":1, "maximum":12},
    "design_target_time_to_first_value": {"enum":["10_MINUTES_OR_LESS","30_MINUTES_OR_LESS"]},
    "design_target_not_achievement": {"const":true},
    "result_type": {"type":"string", "minLength":1},
    "result_explanation": {"type":"string", "minLength":1},
    "machine_reason_codes": {"type":"array", "minItems":1, "items":{"type":"string", "minLength":1}},
    "verification_available": {"const":false},
    "verification_contract_defined": {"const":true},
    "verification_runtime_available": {"const":false},
    "limitations": {"type":"array", "minItems":1, "items":{"type":"string", "minLength":1}},
    "reversible": {"const":true},
    "deletion_supported": {"const":false},
    "deletion_request_path_defined": {"const":true},
    "deletion_runtime_available": {"const":false},
    "next_stage": {"enum":["UNDERSTAND","MONITOR","ENFORCE","STOP"]},
    "non_claims": {"type":"array", "minItems":1, "items":{"type":"string", "minLength":1}}
  }
}
